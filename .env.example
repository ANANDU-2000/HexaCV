# Express Server Port
PORT=3000
NODE_ENV=development

# Database — Drizzle uses MySQL. Prefer the MySQL URL in local/dev.
# DATABASE_URL=mysql://root:password@localhost:3306/hexacv_dev
DATABASE_URL=

# Cache
REDIS_URL=redis://localhost:6379

# Session / JWT (current Manus cookie flow)
JWT_SECRET=change_me_to_a_long_random_secret

# Manus OAuth (current auth until Clerk migration PR)
# VITE_OAUTH_PORTAL_URL=https://auth.hexastacksolutions.com
VITE_APP_ID=
VITE_OWNER_OPEN_ID=

# Provider markers (runtime still Manus + Stripe until migration PRs)
AUTH_PROVIDER=clerk
PAYMENT_PROVIDER=razorpay
AI_PAUSED=false

# Clerk (future — not wired yet)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev

# Razorpay (future — not wired yet; use Dashboard test keys)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LLM Providers
