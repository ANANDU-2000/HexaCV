# Express Server Port
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL for Drizzle, PostgreSQL for Prisma production)
DATABASE_URL=postgresql://user:password@localhost:5432/hexacv_db?schema=public
# For Drizzle (MySQL dev):
# DATABASE_URL=mysql://root:password@localhost:3306/hexacv_dev

# Cache configuration
REDIS_URL=redis://localhost:6379

# JWT secrets for local tokens
JWT_SECRET=your_jwt_secret_key_change_me_in_production

# Manus OAuth Setup
VITE_OAUTH_PORTAL_URL=https://auth.hexastacksolutions.com
VITE_APP_ID=hexacv_app_id
VITE_OWNER_OPEN_ID=admin-key-owner

# LLM Providers Configuration
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=google/gemma-4-31b-it:free

OPENCODE_API_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=your_opencode_key
OPENCODE_MODEL=glm-5.2

BYNARA_API_URL=https://router.bynara.id/v1
BYNARA_API_KEY=your_bynara_key
BYNARA_MODEL=glm-5.2-free

TOKENROUTER_API_URL=https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=your_tokenrouter_key
TOKENROUTER_MODEL=z-ai/glm-5.2-free

OPENAI_API_KEY=your_openai_key
DEEPSEEK_API_KEY=your_deepseek_key
GEMINI_API_KEY=your_gemini_key_1
GEMINI_API_KEY_2=your_gemini_key_2
GROK_API_KEY=your_grok_key
HUGGINGFACE_API_KEY=your_huggingface_api_key
HF_TOKEN=your_huggingface_token

