# =============================================================================
# HexaCV .env.example — copy to .env and fill values (never commit .env)
# See docs/ai/MODELS_AND_KEYS.md, docs/ai/ADMIN_AND_ENV.md, docs/ops/VERCEL_ENV.md
#
# Vercel (frontend only): set ONLY optional public VITE_* keys. Never DATABASE_URL / AI / Razorpay.
# API host = Render hexacv-app: PostgreSQL DATABASE_URL + secrets below.
# MongoDB is NOT used. MySQL is NOT used (migrated to Render Postgres).
# =============================================================================

PORT=3000
NODE_ENV=development

# --- Database (Drizzle = PostgreSQL / Render) ---
# Local/external:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.singapore-postgres.render.com/hexacv?sslmode=require
# Render internal (service ↔ DB private network):
# DATABASE_URL=postgresql://USER:PASSWORD@dpg-xxxxx/hexacv
DATABASE_URL=
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_to_a_long_random_secret

# === AI kill switch ===
AI_PAUSED=false

# === AI rate limits (A3 — failover at 80% RPM / 90% RPD) ===
AI_RPM_LIMIT=60
AI_RPD_LIMIT=2000
# Optional comma-separated ordered fallback model ids (defaults from provider ENVs)
# AI_FALLBACK_MODELS=google/gemma-4-31b-it:free,glm-5.2,gpt-4o-mini

# === AI spend + quotas (B3) ===
AI_DAILY_SPEND_CEILING_USD=5
AI_QUOTA_GUEST=3
AI_QUOTA_FREE=20
AI_QUOTA_PAID=200

# === Auth / Super Admin ===
# Runtime still Manus until Clerk migration. ADMIN_* = CRM mock targets only.
AUTH_PROVIDER=clerk
# VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=
VITE_OWNER_OPEN_ID=
OWNER_OPEN_ID=
ADMIN_EMAIL=admin@hexacv.com
ADMIN_PASSWORD=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_FRONTEND_API=https://your-instance.clerk.accounts.dev

# === Payments (Razorpay primary; Stripe legacy webhook only) ===
# Before LIVE charges: set real RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET,
# RAZORPAY_WEBHOOK_SECRET in the host (never commit). Webhook URL:
# https://<your-host>/api/webhooks/razorpay
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# F4: days of paid access after period end / payment failure
SUBSCRIPTION_GRACE_DAYS=3
# Legacy — do not create new Checkout sessions when PAYMENT_PROVIDER=razorpay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# === LLM: Cheap / free tier ===
OPENROUTER_API_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# === LLM: Rewrite tier (OpenCode, Bynara, TokenRouter) ===
OPENCODE_API_URL=https://opencode.ai/zen/go/v1
OPENCODE_API_KEY=
OPENCODE_MODEL=glm-5.2

BYNARA_API_URL=https://router.bynara.id/v1
BYNARA_API_KEY=
BYNARA_MODEL=glm-5.2-free

TOKENROUTER_API_URL=https://api.tokenrouter.com/v1
TOKENROUTER_API_KEY=
TOKENROUTER_MODEL=z-ai/glm-5.2-free

# === LLM: Premium (OpenAI) — use gpt-4o-mini or gpt-4o only ===
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === LLM: Gemini / Groq failover ===
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GROK_API_KEY=

# === Optional / not used for invokeLLM chat ===
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=
HF_TOKEN=
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=
